{
  "name": "ksef-saas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "next dev",
    "dev:local": "bash scripts/dev/baza-lokalna.sh && next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint --max-warnings 0 --cache --cache-strategy content --cache-location .tmp/eslintcache",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run test:vitest",
    "ksef:test-auth": "tsx scripts/test-ksef-auth.ts",
    "ksef:test-token": "tsx scripts/test-ksef-token.ts",
    "ksef:submit-full": "tsx scripts/test-submit-full.ts",
    "ksef:test-wysylka": "tsx scripts/test-ksef-wysylka.ts",
    "r2:smoke": "tsx scripts/test-r2.ts",
    "fa3:test": "tsx scripts/test-fa3-generation.ts",
    "seed:tenant": "tsx scripts/seed-tenant.ts",
    "seed:invoice": "tsx scripts/seed-test-invoice.ts",
    "db:local": "bash scripts/dev/baza-lokalna.sh",
    "db:push:prod": "node scripts/supabase-push-production.mjs",
    "db:push:prod:dry": "node scripts/supabase-push-production.mjs --dry-run",
    "test": "tsx --test lib/xml/invoice-calculator.test.ts lib/xml/fa3-generator.test.ts lib/xml/validator.test.ts",
    "test:vitest": "vitest run",
    "test:vitest:watch": "vitest",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:wizualne": "playwright test --project=wizualne-iphone --project=wizualne-desktop",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit",
    "test:all": "pnpm test && pnpm test:vitest",
    "load:smoke": "bash scripts/k6-run.sh load-tests/smoke.js",
    "load:run": "bash scripts/k6-run.sh load-tests/main.js",
    "load:dashboard": "bash scripts/k6-run.sh load-tests/scenarios/dashboard-viewer.js",
    "load:invoice": "bash scripts/k6-run.sh load-tests/scenarios/invoice-issuer.js",
    "load:ocr": "bash scripts/k6-run.sh load-tests/scenarios/ocr-scanner.js",
    "load:bulk": "bash scripts/k6-run.sh load-tests/scenarios/bulk-importer.js",
    "load:stress:db": "bash scripts/k6-run.sh load-tests/stress/db-stress.js",
    "load:stress:ocr": "bash scripts/k6-run.sh load-tests/stress/ocr-pipeline.js",
    "load:inbox": "node --conditions=react-server --import tsx load-tests/ksef-inbox/run.ts",
    "perf:lighthouse": "lighthouse --budget-path=load-tests/lighthouse-budget.json --only-categories=performance --chrome-flags=\"--headless\"",
    "verify:fa3": "tsx scripts/verify-fa3-all-types.ts",
    "check:env": "tsx scripts/check-env.ts",
    "worker:dev": "node --import ./lib/jobs/server-only-hook.mjs --import tsx lib/jobs/worker.ts",
    "jobs:smoke": "tsx scripts/pgboss-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.9.2",
    "@mdx-js/loader": "^3.1.1",
    "@next/mdx": "16.4.5",
    "@peculiar/webcrypto": "^1.7.2",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.2.0",
    "@remixicon/react": "^4.9.0",
    "@sentry/nextjs": "^10.78.0",
    "@serwist/next": "^9.5.13",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-table": "8.21.3",
    "@upstash/redis": "^1.41.0",
    "@xmldom/xmldom": "^0.9.12",
    "archiver": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.7.1",
    "motion": "^12.43.0",
    "gray-matter": "^4.0.3",
    "iconv-lite": "^0.7.3",
    "lucide-react": "^1.70.0",
    "material-symbols": "0.48.3",
    "next": "16.4.5",
    "next-mdx-remote": "^6.0.0",
    "p-queue": "^9.3.5",
    "papaparse": "^5.7.0",
    "pdfkit": "^0.20.2",
    "pg-boss": "^12.38.1",
    "posthog-js": "~1.374.2",
    "posthog-node": "^5.63.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "xadesjs": "^2.6.8",
    "xml-core": "^1.2.6",
    "xmlbuilder2": "^4.0.3",
    "xmllint-wasm": "^5.3.0",
    "zod": "^4.6.7"
  },
  "browserslist": [
    "chrome >= 110",
    "edge >= 110",
    "firefox >= 110",
    "safari >= 16",
    "not dead"
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/archiver": "^7.0.0",
    "@types/jsdom": "27.0.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitest/ui": "^4.1.12",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "29.1.1",
    "knip": "6.44.2",
    "serwist": "^9.5.13",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  }
}
