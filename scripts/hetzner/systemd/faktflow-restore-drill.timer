# Plan usprawnień 3.4: niedziela 03:30 UTC, dwie godziny po nocnym zrzucie (01:30).
# Persistent: próba pominięta przez wyłączony serwer rusza po starcie.
[Unit]
Description=FaktWay: cotygodniowa próba odtworzenia zrzutu bazy

[Timer]
OnCalendar=Sun *-*-* 03:30:00 UTC
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
