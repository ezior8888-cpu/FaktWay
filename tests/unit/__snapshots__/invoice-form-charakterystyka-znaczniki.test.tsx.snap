exports[`formularz faktury: znaczniki przed podziałem (3.7c) > baner „Wypełnij”, firma zwolniona z VAT; po kliknięciu baner znika > po wypełnieniu 1`] = `"<form class="space-y-6 pb-32 lg:pb-10"><div class="flex items-center gap-2 sm:hidden"><a aria-label="Wróć do wyboru rodzaju faktury" class="text-muted-foreground hover:bg-muted -ml-2 flex size-10 shrink-0 items-center justify-center transition-colors" href="/invoices/new"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left h-5 w-5" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg></a><div class="min-w-0 flex-1"><h1 class="truncate text-xl font-semibold tracking-tight">Nowa faktura</h1><p class="text-muted-foreground truncate text-sm">październik 2026 · KSeF</p></div><button type="button" class="text-primary shrink-0 px-2 py-2 text-sm font-semibold transition-opacity disabled:opacity-50">Szkic</button></div><div class="space-y-3 hidden sm:block"><a class="text-muted-foreground hover:text-foreground inline-flex items-center gap-1 text-sm" href="/invoices/new"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" aria-hidden="true" class="remixicon size-4"><path d="M7.82843 10.9999H20V12.9999H7.82843L13.1924 18.3638L11.7782 19.778L4 11.9999L11.7782 4.22168L13.1924 5.63589L7.82843 10.9999Z"></path></svg>Rodzaj faktury</a><div><h1 class="text-2xl font-semibold tracking-tight">Nowa faktura</h1><p class="text-muted-foreground text-sm">Wystaw fakturę B2B lub B2C i wyślij do KSeF jednym kliknięciem</p></div></div><div data-testid="wystaw-fakture-siatka" class="grid grid-cols-1 gap-6 lg:grid-cols-[1fr_18rem]"><div data-slot="card" data-size="default" class="group/card bg-card text-card-foreground ring-foreground/10 flex flex-col overflow-hidden rounded-none text-xs/relaxed ring-1 [--card-spacing:--spacing(4)