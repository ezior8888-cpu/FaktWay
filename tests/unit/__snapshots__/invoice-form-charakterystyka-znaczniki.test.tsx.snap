exports[`formularz faktury: znaczniki przed podziałem (3.7c) > baner „Wypełnij”, firma zwolniona z VAT; po kliknięciu baner znika > z banerem 1`] = `"<form class="space-y-6 pb-32 lg:pb-10"><div class="flex items-center gap-2 sm:hidden"><a aria-label="Wróć do wyboru rodzaju faktury" class="text-muted-foreground hover:bg-muted -ml-2 flex size-10 shrink-0 items-center justify-center transition-colors" href="/invoices/new"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left h-5 w-5" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg></a><div class="min-w-0 flex-1"><h1 class="truncate text-xl font-semibold tracking-tight">Nowa faktura</h1><p class="text-muted-foreground truncate text-sm">październik 2026 · KSeF</p></div><button type="button" class="text-primary shrink-0 px-2 py-2 text-sm font-semibold transition-opacity disabled:opacity-50">Szkic</button></div><div class="space-y-3 hidden sm:block"><a class="text-muted-foreground hover:text-foreground inline-flex items-center gap-1 text-sm" href="/invoices/new"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" aria-hidden="true" class="remixicon size-4"><path d="M7.82843 10.9999H20V12.9999H7.82843L13.1924 18.3638L11.7782 19.778L4 11.9999L11.7782 4.22168L13.1924 5.63589L7.82843 10.9999Z"></path></svg>Rodzaj faktury</a><div><h1 class="text-2xl font-semibold tracking-tight">Nowa faktura</h1><p class="text-muted-foreground text-sm">Wystaw fakturę B2B lub B2C i wyślij do KSeF jednym kliknięciem</p></div></div><div class="flex items-start gap-3 border border-[var(--ff-accent)]/25 bg-[var(--ff-accent-tint)] p-4"><span aria-hidden="true" class="bg-primary text-primary-foreground flex size-8 shrink-0 items-center justify-center text-sm font-semibold">F</span><p class="min-w-0 flex-1 text-sm leading-relaxed">Mogę wypełnić to za Ciebie na podstawie ostatniej faktury dla <span class="font-semibold">Klient Poprzedni</span>. <button type="button" class="font-semibold text-[var(--ff-accent)] underline-offset-4 hover:underline">Wypełnij →</button></p></div><div data-testid="wystaw-fakture-siatka" class="grid grid-cols-1 gap-6 lg:grid-cols-[1fr_18rem]"><div data-slot="card" data-size="default" class="group/card bg-card text-card-foreground ring-foreground/10 flex flex-col overflow-hidden rounded-none text-xs/relaxed ring-1 [--card-spacing:--spacing(4)] has-data-[slot=card-footer]:pb-0 has-[>img:first-child]:pt-0 data-[size=sm]:[--card-spacing:--spacing(3)] data-[size=sm]:has-data-[slot=card-footer]:pb-0 *:[img:first-child]:rounded-none *:[img:last-child]:rounded-none min-w-0 gap-6 py-0 shadow-none" data-testid="dokument-formularza"><div class="bg-muted/50 flex flex-wrap items-start justify-between gap-6 p-4 sm:p-6"><div data-testid="sprzedawca" class="min-w-0 space-y-2"><p class="text-muted-foreground text-xs font-medium">Sprzedawca</p><div class="text-muted-foreground space-y-1 text-sm"><p>Dane sprzedawcy weźmiemy z profilu firmy.</p><a class="text-primary underline-offset-4 hover:underline" href="/settings">Sprawdź dane firmy</a></div></div><div class="w-full shrink-0 space-y-3 sm:w-auto"><div class="space-y-1"><div class="flex flex-col gap-1.5 sm:flex-row sm:items-center sm:justify-between sm:gap-3"><label data-slot="label" class="flex items-center gap-2 select-none group-data-[disabled=true]:pointer-events-none group-data-[disabled=true]:opacity-50 peer-disabled:cursor-not-allowed peer-disabled:opacity-50 text-sm font-medium sm:shrink-0" for="internalNumber">Numer faktury</label><div class="w-full sm:w-44 sm:flex-none"><input id="internalNumber" data-slot="input" placeholder="FV/2026/04/001" class="border-input file:text-foreground placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-ring/50 disabled:bg-input/50 aria-invalid:border-destructive aria-in