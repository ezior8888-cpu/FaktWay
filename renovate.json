{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "group:allNonMajor"
  ],
  "timezone": "Europe/Warsaw",
  "schedule": ["before 6am every weekday"],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Poprawki (patch) razem w jednym PR. Bez automatycznego scalania: scala tylko Bartosz (AGENTS.md)",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "groupName": "patch updates",
      "automerge": false
    },
    {
      "description": "Wszystkie dev dependencies w jednym PR-ze (testy, linter, types)",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dev dependencies",
      "automerge": false
    },
    {
      "description": "Paczki krytyczne dla bezpieczeństwa — osobny PR, manual review",
      "matchPackageNames": [
        "@supabase/ssr",
        "@supabase/supabase-js",
        "next",
        "@sentry/nextjs",
        "@aws-sdk/client-s3",
        "@aws-sdk/s3-request-presigner",
        "xml-crypto",
        "xadesjs",
        "@peculiar/webcrypto",
        "stripe",
        "pg-boss",
        "@anthropic-ai/sdk",
        "xmllint-wasm",
        "@xmldom/xmldom",
        "fast-xml-parser"
      ],
      "groupName": "security-critical",
      "automerge": false,
      "labels": ["dependencies", "security-review-required"]
    },
    {
      "description": "Major bumps Next/React — zawsze ręcznie + breaking-changes label",
      "matchPackageNames": ["next", "react", "react-dom"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "breaking-changes"]
    },
    {
      "description": "Nadpisania w pnpm-workspace.yaml trzymają łatki w obrębie wersji głównej, której oczekują zależności. Bez podbicia o wersję główną (#406 i #458 zamknięte 08.11.2026)",
      "matchPackageNames": ["brace-expansion", "@hono/node-server"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "posthog-js osobno: 1.447 to ok. +59 kB gzip w First Load JS każdej trasy panelu (budżet 750 kB, #497). Podbicie razem z leniwym ładowaniem analityki",
      "matchPackageNames": ["posthog-js"],
      "matchUpdateTypes": ["minor", "major"],
      "groupName": "posthog-js",
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "groupName": "security updates",
    "minimumReleaseAge": null,
    "labels": ["dependencies", "security"],
    "automerge": false
  },
  "osvVulnerabilityAlerts": true,
  "prHourlyLimit": 4,
  "prConcurrentLimit": 6
}
