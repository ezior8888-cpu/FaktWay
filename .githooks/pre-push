#!/usr/bin/env bash
# Szybka kontrola przed pushem: adresy serwerów z `.agents/infra.env` w nowych
# liniach (repo jest publiczne), strażnik tekstów dla klienta, typy, eslint
# zmienionych plików i testy Vitest związane ze zmienionymi plikami
# (`vitest related`). To siatka bezpieczeństwa, nie zamiennik
# `pnpm run ci && pnpm build` z AGENTS.md.
#
# Włącza go `scripts/dev/przygotuj-worktree.sh` (git config core.hooksPath
# .githooks). Milczy, gdy wszystko gra. Trwa od kilku sekund do ok. 3 minut
# (zmiana w pliku importowanym wszędzie uruchamia większość testów).
# Pominięcie tylko przy awarii: SKIP_PREPUSH=1 git push   albo   git push --no-verify
# (w sesjach Claude blokuje to hook żelaznego filtra; CI i tak powtarza filtr).
set -uo pipefail

[ "${SKIP_PREPUSH:-}" = 1 ] && exit 0
cd "$(git rev-parse --show-toplevel)" || exit 0
# Git przekazuje hookowi GIT_DIR i pokrewne zmienne prawdziwego repo. Po `cd`
# git sam znajduje repo, a narzędzia niżej (node, vitest z testami, które
# zakładają własne repo w katalogu tymczasowym) nie mogą ich dziedziczyć:
# 11.11.2026 `git init` w teście przestawił przez GIT_DIR prawdziwe repo na core.bare=true.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_PREFIX GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

zero=0000000000000000000000000000000000000000
changed=""
changed_all=""                                    # także usunięte, bez przeniesień, bez cytowania polskich znaków
ranges=()
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # usuwanie gałęzi
  base="$(git merge-base origin/main "$local_sha" 2>/dev/null)" || continue
  ranges+=("$base..$local_sha")
  changed+="$(git diff --name-only --diff-filter=ACMR "$base" "$local_sha")"$'\n'
  changed_all+="$(git -c core.quotePath=false diff --name-only --no-renames "$base" "$local_sha")"$'\n'
done
[ ${#ranges[@]} -gt 0 ] || exit 0

# Adresy i identyfikatory serwerów nie mogą wrócić do publicznego repo.
# Wartości czytamy z lokalnego pliku i nigdzie ich nie wypisujemy.
if [ -f .agents/infra.env ]; then
  added="$(for r in "${ranges[@]}"; do git diff --no-color --unified=0 "$r" -- . ':!pnpm-lock.yaml'; done | grep '^+' | grep -v '^+++')"
  for name in APP OPS DB PGC RESTC APP_PREFIX WORKER_PREFIX LOCAL_SUPABASE_REF; do
    value="$( (set +u; . .agents/infra.env >/dev/null 2>&1; printenv "$name") )"
    [ ${#value} -ge 6 ] || continue
    if printf '%s' "$added" | grep -qF -- "$value"; then
      echo "pre-push: nowe linie zawierają wartość \$$name z .agents/infra.env — push zatrzymany." >&2
      echo "Repo jest publiczne. Użyj zmiennej zamiast wartości (AGENTS.md, „Skąd wziąć adresy”)." >&2
      exit 1
    fi
  done
fi
# Żelazny filtr (docs/koordynacja/PLAN-ZELAZNY-FILTR.md, B5.3): plik z sygnałem
# poza mapą ryzyka zatrzymuje push; zmiana R1 albo R2 uruchamia niżej testy
# filtra. Błąd samego klasyfikatora tylko ostrzega (CI i tak powtarza filtr).
filtr_poziom=""
if [ -f scripts/filtr/mapa.mjs ]; then
  filtr_diff="$(mktemp)"
  for r in "${ranges[@]}"; do git diff --no-color -M -U0 "$r"; done >"$filtr_diff"
  filtr_out="$(node scripts/filtr/mapa.mjs --diff-z-pliku "$filtr_diff" 2>&1)"
  filtr_kod=$?
  rm -f "$filtr_diff"
  if [ "$filtr_kod" -eq 1 ]; then
    echo "pre-push: żelazny filtr, plik z sygnałem poza mapą ryzyka; push zatrzymany." >&2
    printf '%s\n' "$filtr_out" | tail -30 >&2
    exit 1
  elif [ "$filtr_kod" -ne 0 ]; then
    echo "pre-push: klasyfikator filtra nie zadziałał (kod $filtr_kod), sprawdzi to CI:" >&2
    printf '%s\n' "$filtr_out" | tail -5 >&2
  fi
  filtr_poziom="$(printf '%s\n' "$filtr_out" | sed -n 's/^\[FILTR\] Poziom zmiany: \(R[0-3]\).*/\1/p' | head -1)"
fi
filtr_testy=0
case "$filtr_poziom" in R1|R2) [ -f vitest.filtr.config.ts ] && filtr_testy=1 ;; esac

# Strażnik tekstów dla klienta (tests/unit/teksty-straznik.test.ts) czyta pliki
# przez `git ls-files`, nie przez importy, więc `vitest related` go nie znajdzie
# i długi myślnik w nowym komunikacie wychodził dopiero w CI (#538, #660).
# Uruchamiamy go, gdy push zmienia albo usuwa plik w katalogach, które czyta
# (tych samych co w strażniku, pilnuje tego tests/unit/hak-straznik-tekstow.test.ts),
# albo jego zapisany stan. Here-string, nie `printf | grep -q`: przy pipefail
# długa lista dawała fałszywe „brak” (grep kończy wcześniej, printf dostaje SIGPIPE).
teksty=0
if [ -f tests/unit/teksty-straznik.test.ts ] &&
  grep -qE '^(app|components|lib|hooks|content)/|^tests/unit/(teksty-straznik\.test\.ts|fixtures/teksty-stan\.json)$' <<<"$changed_all"; then
  teksty=1
fi

code="$(printf '%s' "$changed" | grep -E '\.(ts|tsx|js|mjs|cjs)$' | sort -u | while read -r f; do [ -f "$f" ] && echo "$f"; done)"
[ -n "$code" ] || [ "$filtr_testy" -eq 1 ] || [ "$teksty" -eq 1 ] || exit 0
# Typy, eslint i testy potrzebują zależności; kontrola adresów wyżej ich nie potrzebuje.
[ -d node_modules ] || { echo "pre-push: brak node_modules, typy i testy pominięte (pnpm install)" >&2; exit 0; }

log="$(mktemp)"
trap 'rm -f "$log"' EXIT
fail() {
  echo "pre-push: $1 — push zatrzymany. Ostatnie linie:" >&2
  tail -40 "$log" >&2
  echo "(pominięcie: SKIP_PREPUSH=1 git push)" >&2
  exit 1
}

# Strażnik tekstów najpierw: trwa kilka sekund, a typy nawet minutę. Pusta
# ZAPISZ_STAN_TEKSTOW, żeby hook nigdy nie przepisał stanu strażnika.
if [ "$teksty" -eq 1 ]; then
  ZAPISZ_STAN_TEKSTOW='' pnpm -s exec vitest run tests/unit/teksty-straznik.test.ts >"$log" 2>&1 ||
    fail "strażnik tekstów czerwony (długi myślnik albo plakietka w tekście dla klienta, albo stan do zapisania)"
fi
if [ -n "$code" ]; then
  pnpm -s typecheck >"$log" 2>&1 || fail "pnpm typecheck czerwony"
  # shellcheck disable=SC2086
  printf '%s\n' "$code" | xargs pnpm -s eslint --no-warn-ignored >"$log" 2>&1 || fail "eslint zmienionych plików czerwony"
  # shellcheck disable=SC2086
  printf '%s\n' "$code" | xargs pnpm -s vitest related --run --passWithNoTests >"$log" 2>&1 || fail "vitest related czerwony"
fi
if [ "$filtr_testy" -eq 1 ]; then
  pnpm -s exec vitest run --config vitest.filtr.config.ts >"$log" 2>&1 || fail "testy żelaznego filtra (zmiana $filtr_poziom) czerwone"
fi
exit 0
